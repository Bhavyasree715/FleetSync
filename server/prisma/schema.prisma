// Prisma schema for FleetSync
// Defaults to SQLite for seamless local demo, switchable to PostgreSQL

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String
  name         String
  role         String             // 'manager' | 'driver'
  phone        String?
  language     String             @default("en") // 'en' | 'ta' | 'hi'
  theme        String             @default("light") // 'light' | 'dark'
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  driver       Driver?
  sentMessages Message[]          @relation("SentMessages")
  pushSubs     PushSubscription[]
  auditLogs    AuditLog[]
}

model Driver {
  id             String     @id @default(uuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId      String?    @unique
  vehicle        Vehicle?   @relation(fields: [vehicleId], references: [id])
  licenseNumber  String
  safetyScore    Int        @default(90) // 0-100 score
  totalTrips     Int        @default(0)
  totalDistanceKm Float     @default(0.0)
  onDuty         Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  trips          Trip[]
  fuelLogs       FuelLog[]
}

model Vehicle {
  id             String           @id @default(uuid())
  plateNumber    String           @unique
  model          String
  type           String           @default("truck") // 'truck' | 'van' | 'car' | 'bike'
  status         String           @default("offline") // 'moving' | 'arrived' | 'idle' | 'offline'
  speedLimit     Float            @default(60.0) // km/h
  currentLat     Float?
  currentLng     Float?
  currentSpeed   Float            @default(0.0)
  currentHeading Float            @default(0.0)
  batteryLevel   Int?             @default(95) // percentage
  accuracy       Float?           @default(5.0) // meters
  lastActiveAt   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  driver         Driver?
  locations      LocationPoint[]
  trips          Trip[]
  alerts         Alert[]
  maintenanceLogs MaintenanceLog[]
  fuelLogs       FuelLog[]
}

model LocationPoint {
  id        String   @id @default(uuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tripId    String?
  trip      Trip?    @relation(fields: [tripId], references: [id])
  lat       Float
  lng       Float
  speed     Float    @default(0.0)
  heading   Float    @default(0.0)
  accuracy  Float    @default(5.0)
  battery   Int?
  timestamp DateTime @default(now())

  @@index([vehicleId, timestamp])
  @@index([tripId, timestamp])
}

model Trip {
  id                   String          @id @default(uuid())
  trackingCode         String          @unique // e.g. FS-TRIP-7482
  vehicleId            String?
  vehicle              Vehicle?        @relation(fields: [vehicleId], references: [id])
  driverId             String?
  driver               Driver?         @relation(fields: [driverId], references: [id])
  title                String
  pickupAddress        String
  pickupLat            Float
  pickupLng            Float
  dropAddress          String
  dropLat              Float
  dropLng              Float
  status               String          @default("pending") // 'pending' | 'assigned' | 'in_progress' | 'completed' | 'cancelled'
  priority             String          @default("normal") // 'low' | 'normal' | 'urgent'
  distanceKm           Float           @default(0.0)
  estimatedDurationMin Int             @default(30)
  actualDurationMin    Int?
  startAt              DateTime?
  endAt                DateTime?
  maxSpeed             Float           @default(0.0)
  avgSpeed             Float           @default(0.0)
  recipientName        String?
  recipientPhone       String?
  signatureData        String?         // base64 svg/png digital signature
  proofPhotoUrl        String?         // base64 image or url
  notes                String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  locations            LocationPoint[]
  alerts               Alert[]
  messages             Message[]
}

model Geofence {
  id             String   @id @default(uuid())
  name           String
  type           String   @default("circle") // 'circle' | 'polygon'
  centerLat      Float
  centerLng      Float
  radiusMeters   Float    @default(500.0)
  polygonGeoJson String?  // JSON string of [[lat, lng], ...]
  alertOnEntry   Boolean  @default(true)
  alertOnExit    Boolean  @default(true)
  color          String   @default("#3b82f6")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Alert {
  id             String    @id @default(uuid())
  type           String    // 'overspeed' | 'geofence_entry' | 'geofence_exit' | 'idle' | 'offline' | 'sos'
  severity       String    @default("warning") // 'info' | 'warning' | 'critical'
  message        String
  vehicleId      String?
  vehicle        Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tripId         String?
  trip           Trip?     @relation(fields: [tripId], references: [id])
  lat            Float?
  lng            Float?
  speed          Float?
  isAcknowledged Boolean   @default(false)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([vehicleId, createdAt])
}

model RuleSettings {
  id                      String   @id @default("global-settings")
  overspeedThreshold      Float    @default(65.0) // km/h global fallback
  truckSpeedLimit         Float    @default(50.0)
  vanSpeedLimit           Float    @default(65.0)
  carSpeedLimit           Float    @default(80.0)
  bikeSpeedLimit          Float    @default(50.0)
  idleMinutesThreshold    Int      @default(5) // minutes
  offlineSecondsThreshold Int      @default(30) // seconds
  autoDispatchEnabled     Boolean  @default(false)
  mapProvider             String   @default("osm") // 'osm' | 'google'
  notificationSound       Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

model Message {
  id         String   @id @default(uuid())
  tripId     String?
  trip       Trip?    @relation(fields: [tripId], references: [id])
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model MaintenanceLog {
  id            String    @id @default(uuid())
  vehicleId     String
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceType   String    // 'Oil Change', 'Brake Inspection', 'Tire Rotation', etc.
  scheduledKm   Float?
  actualKm      Float?
  scheduledDate DateTime
  completedDate DateTime?
  cost          Float     @default(0.0)
  status        String    @default("scheduled") // 'scheduled' | 'overdue' | 'completed'
  notes         String?
  createdAt     DateTime  @default(now())
}

model FuelLog {
  id         String   @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id])
  liters     Float
  totalCost  Float
  odometerKm Float
  station    String?
  receiptUrl String?
  filledAt   DateTime @default(now())
  createdAt  DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}
